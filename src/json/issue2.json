	"pages": [
		{
			"format": "fullpage",
			"type": "mainPage",
			"headline": "Ghosts are out Tonight!",
			"text": [
				{
					"text": "Don't be bemused, it's just the news! Flatland is flooded with ghosts for the Halloween party.",
					"x": 25,
					"y": 130,
					"width": 375,
					"font": 22
				},
				{
					"text": "As part of the party, candies are falling from the skies and being exchanged for masks.",
					"x": 25,
					"y": 220,
					"width": 375,
					"font": 22
				},
				{
					"text": "Flatters all around the land are reporting strange sights, some are even saying that \"He\" is coming. We are yet to know who is \"He\" and what such person wants.",
					"x": 25,
					"y": 340,
					"width": 375,
					"font": 22
				},
				{
					"text": "Turn the page, take a break from the grind and find out the winners of the writing competition and some of their awesome player creations!",
					"x": 25,
					"y": 470,
					"width": 375,
					"font": 22
				}
			]
		},
		{
			"format": "fullpage",
			"type": "featuredArea",
			"headline": "Mystic Vale\nOrb Pile",
			"text": [
				{
					"text": "In earlier versions the meteor could spawn here, but was removed due to lag.",
					"x": 70,
					"y": 240,
					"font": 12
				},
				{
					"text": "The Mystic Vale Orb Pile is a place where most Flatters go to dig for Unpowered Orbs, either during the day or while they sleep.",
					"x": 25,
					"y": 320,
					"font": 24
				},
				{
					"text": "The Pile has been very popular ever since the game's release many moons ago. It stands as the most popular room in the whole of Flatmmo.",
					"x": 25,
					"y": 450,
					"font": 24
				},
				{
					"text": "It may not be the best place to get those juicy Enchanting XP, but if you are in need of some unpowered orbs and don't want to spend your days grinding them, we truly recommend coming down to the Orb Pile when you decide to catch some ZZZ's",
					"x": 630,
					"y": 50,
					"font": 24
				}
			],
